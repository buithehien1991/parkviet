<!DOCTYPE html>
<html lang="vi">
  <head>
    <title data-inertia><%= content_for(:title) || "Park Việt" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Park Việt">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= vite_typescript_tag "inertia.tsx" if inertia_rendering? %>
    <%= inertia_ssr_head %>
  </head>
  <body>
    <%= inertia_rendering? ? inertia_root : yield %>
  </body>
</html>
